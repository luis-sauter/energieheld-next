# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Deterministic public JSX search catalog; generated before dev/build/test/typecheck.
/src/data/generated/public-search-pages.json

# Isolated Python acquisition runtime artifacts (never research data or packages).
/workers/acquisition/__pycache__/

# Local coding-assistant instructions; Next.js may regenerate these files.
/AGENTS.md
/CLAUDE.md
/README.md

# Internal working notes and research exports are not public source files.
/docs/*.md
/docs/auth-email-templates/README.md
/docs/autumn-editorial-image.json
/workers/acquisition/README.md
/supabase/proposals/README.md
/.legacy-reiseportal/
/qa/
/backups/
/.internal/

# Editorial generation notes must never be served from public/.
/public/reiseportal/destination-editorial/manifest.json
/public/reiseportal/motto-editorial-v2/manifest.json
/public/reiseportal/news/manifest.json

# Private acquisition code, evidence and historical data imports live separately.
/workers/
/scripts/*
!/scripts/build-portal-search-catalog.mjs
!/scripts/build-europe-map.mjs
