# Copy to .env.local and fill in your project's public connection details.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only SEO launch configuration. Leave indexing disabled on test deploys.
# SITE_URL must be the confirmed HTTPS production origin, never a preview URL.
SITE_URL=
SITE_INDEXING=disabled
# Set to preview on non-production hosts without a built-in deploy context.
SITE_ENVIRONMENT=preview

# Server-only offer notifications. Set these in the hosting environment, never NEXT_PUBLIC_.
OFFER_NOTIFICATION_ENABLED=false
OFFER_NOTIFICATION_ORIGIN=
OFFER_NOTIFICATION_FROM=
OFFER_NOTIFICATION_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
