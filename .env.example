# Copy to .env.local and fill in the public connection details for energieheld-dev.
NEXT_PUBLIC_SUPABASE_URL=https://mbcvlqnxluyxznlnitbq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only SEO launch configuration. Leave indexing disabled on test deploys.
# SITE_URL must be the confirmed HTTPS production origin, never a preview URL.
SITE_URL=
SITE_INDEXING=disabled
# Set to preview on non-production hosts without a built-in deploy context.
SITE_ENVIRONMENT=preview
